---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{hasProjects && (
  <section id="projects" class="section-shell px-8 py-16 sm:px-12 md:px-20 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="section-kicker">Selected work</p>
          <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl md:text-5xl">Projects</h2>
          <div class="mt-4 h-1.5 w-20 rounded-full" style={`background-color: ${siteConfig.accentColor}`}></div>
        </div>
        <div class="lg:col-span-8"></div>
      </div>

      <div class="mt-14 space-y-16 md:space-y-24">
        {siteConfig.projects.map((project, index) => {
          const modalId = `project-modal-${index}`;
          const reversed = index % 2 === 1;

          return (
            <>
              <article class={`grid items-center gap-10 lg:grid-cols-2 lg:gap-16 ${reversed ? 'lg:[&>*:first-child]:order-2 lg:[&>*:last-child]:order-1' : ''}`}>
                <div>
                  <p class="text-sm uppercase tracking-[0.22em] text-white/42">{String(index + 1).padStart(2, '0')}</p>
                  {project.previewEyebrow && (
                    <p class="mt-6 text-sm uppercase tracking-[0.24em]" style={`color: ${siteConfig.accentColor}`}>
                      {project.previewEyebrow}
                    </p>
                  )}
                  <h3 class="mt-4 max-w-xl text-4xl font-semibold leading-tight text-white sm:text-5xl md:text-6xl">
                    {project.name}
                  </h3>
                  <p class="mt-8 max-w-2xl text-xl leading-9 text-white/68">
                    {project.description}
                  </p>

                  {project.skills && project.skills.length > 0 && (
                    <div class="mt-8 flex flex-wrap gap-x-5 gap-y-3 text-sm uppercase tracking-[0.18em] text-white/42">
                      {project.skills.map((skill) => (
                        <span>{skill}</span>
                      ))}
                    </div>
                  )}

                  <div class="mt-10 flex flex-wrap items-center gap-6 text-base">
                    <button
                      type="button"
                      class="inline-flex cursor-pointer items-center gap-3 text-white transition-opacity hover:opacity-80"
                      data-modal-open={modalId}
                    >
                      <span class="inline-flex h-12 w-12 items-center justify-center border border-white/16 bg-white text-black">■</span>
                      <span>Read more</span>
                    </button>

                    {project.links && project.links.length > 0 && project.links.map((link) => (
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 text-white/72 transition-colors hover:text-white"
                      >
                        <span>{link.label}</span>
                        <span aria-hidden="true">↗</span>
                      </a>
                    ))}
                  </div>
                </div>

                <div>
                  <div class="relative overflow-hidden bg-[#0a0f1d]">
                    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(98,127,47,0.18),transparent_32%),radial-gradient(circle_at_bottom_right,rgba(255,255,255,0.06),transparent_24%)]"></div>
                    {project.previewImage ? (
                      <img
                        src={project.previewImage}
                        alt={project.previewAlt ?? project.name}
                        class="relative aspect-[1.2/1] w-full object-cover transition duration-500 ease-out hover:scale-[1.02]"
                      />
                    ) : (
                      <div class="relative flex aspect-[1.2/1] items-end p-8">
                        <div>
                          <p class="text-sm uppercase tracking-[0.22em] text-white/40">Project preview</p>
                          <p class="mt-4 max-w-sm text-3xl font-semibold leading-tight text-white/92">{project.name}</p>
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              </article>

              <dialog id={modalId} class="modal-backdrop w-[min(42rem,calc(100vw-2rem))] rounded-[1.75rem] border border-white/10 bg-[#08101d] p-0 text-white shadow-2xl backdrop:bg-black/70">
                <div class="glass-card rounded-[1.75rem] p-6 md:p-8">
                  <div class="flex items-start justify-between gap-6">
                    <div>
                      <p class="section-kicker">Project</p>
                      <h3 class="mt-3 text-2xl font-semibold text-white md:text-3xl">{project.name}</h3>
                    </div>
                    <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white/72 transition hover:bg-white/10" data-modal-close={modalId}>✕</button>
                  </div>
                  <p class="mt-6 text-base leading-8 text-white/72">{project.description}</p>
                  {project.skills && project.skills.length > 0 && (
                    <div class="mt-6 flex flex-wrap gap-2.5">
                      {project.skills.map((skill) => (
                        <span class="rounded-full border border-white/10 bg-white/6 px-3 py-1.5 text-sm text-white/82">{skill}</span>
                      ))}
                    </div>
                  )}
                  {project.links && project.links.length > 0 && (
                    <div class="mt-8 flex flex-wrap gap-3">
                      {project.links.map((link) => (
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center rounded-full border px-4 py-2 text-sm font-medium transition-all hover:-translate-y-0.5 hover:text-white"
                          style={`border-color: ${siteConfig.accentColor}88; color: ${siteConfig.accentColor}; background: rgba(255,255,255,0.02);`}
                          onMouseOver={`this.style.backgroundColor='${siteConfig.accentColor}'; this.style.color='white';`}
                          onMouseOut={`this.style.backgroundColor='rgba(255,255,255,0.02)'; this.style.color='${siteConfig.accentColor}';`}
                        >
                          {link.label}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </dialog>
            </>
          );
        })}
      </div>
    </div>
  </section>
)}
