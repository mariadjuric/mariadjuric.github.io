---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{hasProjects && (
  <section id="projects" class="section-shell px-8 py-16 sm:px-12 md:px-20 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="section-kicker">Selected work</p>
          <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl md:text-5xl">Projects</h2>
          <div class="mt-4 h-1.5 w-20 rounded-full" style={`background-color: ${siteConfig.accentColor}`}></div>
          <p class="mt-6 max-w-sm text-lg leading-8 text-white/56">
            Same layout, just more depth: cleaner cards, better motion, and expandable detail when someone wants to linger.
          </p>
        </div>
        <div class="space-y-6 lg:col-span-8">
          {siteConfig.projects.map((project, index) => {
            const modalId = `project-modal-${index}`;
            return (
              <>
                <article class="glass-card hover-lift rounded-[2rem] p-6 md:p-8">
                  <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                    <div>
                      <p class="text-sm font-medium tracking-[0.2em] text-white/35">{String(index + 1).padStart(2, '0')}</p>
                      <h3 class="mt-2 text-2xl font-semibold text-white">{project.name}</h3>
                    </div>
                    <div class="flex flex-wrap gap-3">
                      <button
                        type="button"
                        class="inline-flex cursor-pointer items-center rounded-full border border-white/14 bg-white/4 px-4 py-2 text-sm font-medium text-white/88 transition-all hover:-translate-y-0.5 hover:border-white/28 hover:bg-white/10"
                        data-modal-open={modalId}
                      >
                        Quick view
                      </button>
                      {project.links && project.links.length > 0 && project.links.map((link) => (
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center rounded-full border px-4 py-2 text-sm font-medium transition-all hover:-translate-y-0.5 hover:text-white"
                          style={`border-color: ${siteConfig.accentColor}88; color: ${siteConfig.accentColor}; background: rgba(255,255,255,0.02);`}
                          onMouseOver={`this.style.backgroundColor='${siteConfig.accentColor}'; this.style.color='white';`}
                          onMouseOut={`this.style.backgroundColor='rgba(255,255,255,0.02)'; this.style.color='${siteConfig.accentColor}';`}
                        >
                          {link.label}
                        </a>
                      ))}
                    </div>
                  </div>
                  <p class="mt-5 text-lg leading-8 text-white/70">{project.description}</p>
                  {project.skills && project.skills.length > 0 && (
                    <div class="mt-6 flex flex-wrap gap-2.5">
                      {project.skills.map((skill) => (
                        <span class="rounded-full border border-white/10 bg-white/6 px-3 py-1.5 text-sm text-white/82">{skill}</span>
                      ))}
                    </div>
                  )}
                </article>

                <dialog id={modalId} class="modal-backdrop w-[min(42rem,calc(100vw-2rem))] rounded-[1.75rem] border border-white/10 bg-[#08101d] p-0 text-white shadow-2xl backdrop:bg-black/70">
                  <div class="glass-card rounded-[1.75rem] p-6 md:p-8">
                    <div class="flex items-start justify-between gap-6">
                      <div>
                        <p class="section-kicker">Project</p>
                        <h3 class="mt-3 text-2xl font-semibold text-white md:text-3xl">{project.name}</h3>
                      </div>
                      <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white/72 transition hover:bg-white/10" data-modal-close={modalId}>✕</button>
                    </div>
                    <p class="mt-6 text-base leading-8 text-white/72">{project.description}</p>
                    {project.skills && project.skills.length > 0 && (
                      <div class="mt-6 flex flex-wrap gap-2.5">
                        {project.skills.map((skill) => (
                          <span class="rounded-full border border-white/10 bg-white/6 px-3 py-1.5 text-sm text-white/82">{skill}</span>
                        ))}
                      </div>
                    )}
                    {project.links && project.links.length > 0 && (
                      <div class="mt-8 flex flex-wrap gap-3">
                        {project.links.map((link) => (
                          <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center rounded-full border px-4 py-2 text-sm font-medium transition-all hover:-translate-y-0.5 hover:text-white"
                            style={`border-color: ${siteConfig.accentColor}88; color: ${siteConfig.accentColor}; background: rgba(255,255,255,0.02);`}
                            onMouseOver={`this.style.backgroundColor='${siteConfig.accentColor}'; this.style.color='white';`}
                            onMouseOut={`this.style.backgroundColor='rgba(255,255,255,0.02)'; this.style.color='${siteConfig.accentColor}';`}
                          >
                            {link.label}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </dialog>
              </>
            );
          })}
        </div>
      </div>
    </div>
  </section>
)}
