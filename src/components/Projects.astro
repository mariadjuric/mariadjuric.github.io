---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{hasProjects && (
  <section id="projects" class="bg-gray-50 px-8 py-16 sm:px-12 md:px-20 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="text-3xl font-bold text-gray-900 sm:text-4xl md:text-5xl">Projects</h2>
          <div class="mt-3 h-1.5 w-20 rounded-full" style={`background-color: ${siteConfig.accentColor}`}></div>
        </div>
        <div class="space-y-6 lg:col-span-8">
          {siteConfig.projects.map((project, index) => (
            <article class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md md:p-8">
              <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                <div>
                  <p class="text-sm font-medium tracking-[0.2em] text-gray-400">{String(index + 1).padStart(2, '0')}</p>
                  <h3 class="mt-2 text-2xl font-semibold text-gray-900">{project.name}</h3>
                </div>
                {project.links && project.links.length > 0 && (
                  <div class="flex flex-wrap gap-3">
                    {project.links.map((link) => (
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center rounded-full border px-4 py-2 text-sm font-medium transition-colors hover:text-white"
                        style={`border-color: ${siteConfig.accentColor}; color: ${siteConfig.accentColor};`}
                        onMouseOver={`this.style.backgroundColor='${siteConfig.accentColor}'; this.style.color='white';`}
                        onMouseOut={`this.style.backgroundColor='transparent'; this.style.color='${siteConfig.accentColor}';`}
                      >
                        {link.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
              <p class="mt-5 text-lg leading-8 text-gray-700">{project.description}</p>
              {project.skills && project.skills.length > 0 && (
                <div class="mt-6 flex flex-wrap gap-2.5">
                  {project.skills.map((skill) => (
                    <span class="rounded-full bg-gray-900 px-3 py-1.5 text-sm text-white">{skill}</span>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
