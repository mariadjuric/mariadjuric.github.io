---
import { siteConfig } from "../config";
const hasBlog = siteConfig.blog && siteConfig.blog.length > 0;
---

{hasBlog && (
  <section id="blog" class="section-shell px-8 py-16 sm:px-12 md:px-20 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="section-kicker">Writing</p>
          <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl md:text-5xl">Blog</h2>
          <div class="mt-4 h-1.5 w-20 rounded-full" style={`background-color: ${siteConfig.accentColor}`}></div>
        </div>
        <div class="lg:col-span-8"></div>
      </div>

      <div class="mt-14 space-y-16 md:space-y-24">
        {siteConfig.blog.map((post, index) => {
          const reversed = index % 2 === 1;
          const matchingProject = siteConfig.projects?.find((project) =>
            project.links?.some((link) => link.url === post.url)
          );
          const githubLink = matchingProject?.links?.find((link) =>
            link.label.toLowerCase().includes("github")
          );
          const useFmapEmbed = post.url === "/blog/fmap-paper-atlas";
          const isVideoPreview = post.previewImage?.endsWith(".mp4");

          return (
            <article
              class={`blog-preview-trigger grid items-center gap-10 lg:grid-cols-2 lg:gap-16 ${reversed ? 'lg:[&>*:first-child]:order-2 lg:[&>*:last-child]:order-1' : ''}`}
              data-preview-image={post.previewImage ?? "/profile.png"}
              data-preview-alt={post.previewAlt ?? post.title}
              data-preview-title={post.title}
              data-preview-description={post.description}
              data-preview-eyebrow={post.previewEyebrow ?? "Featured preview"}
              tabindex="0"
            >
              <div>
                <p class="text-sm uppercase tracking-[0.22em] text-white/42">{String(index + 1).padStart(2, '0')}</p>
                {post.previewEyebrow && (
                  <p class="mt-6 text-sm uppercase tracking-[0.24em]" style={`color: ${siteConfig.accentColor}`}>
                    {post.previewEyebrow}
                  </p>
                )}
                <div class="mt-6 flex flex-wrap items-center gap-3 text-sm">
                  {post.status?.trim() && (
                    <span class="inline-flex items-center px-3 py-1 text-sm font-light" style={`color: ${siteConfig.accentColor};`}>
                      {post.status}
                    </span>
                  )}
                </div>
                <h3 class="mt-4 max-w-xl text-4xl font-semibold leading-[0.98] tracking-[-0.035em] text-white sm:text-5xl md:text-[4.6rem]">
                  {post.title}
                </h3>
                <p class="mt-8 max-w-2xl text-xl leading-9 text-white/68">
                  {post.description}
                </p>

                <div class="mt-10 flex flex-wrap items-center gap-6 text-base">
                  {post.url && (
                    <a
                      href={post.url}
                      class="inline-flex items-center gap-3 text-white transition-opacity hover:opacity-80"
                    >
                      <span class="inline-flex h-12 w-12 items-center justify-center text-white/80">■</span>
                      <span>Read more</span>
                    </a>
                  )}

                  {githubLink && (
                    <a
                      href={githubLink.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 text-white/72 transition-colors hover:text-white"
                    >
                      <span>GitHub</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </div>

              <div>
                <div class="relative overflow-visible bg-transparent">
                  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(98,127,47,0.14),transparent_32%),radial-gradient(circle_at_bottom_right,rgba(255,255,255,0.04),transparent_24%)]"></div>
                  {useFmapEmbed ? (
                    <div class="relative aspect-[1.2/1] w-full">
                      <div class="absolute inset-0 z-10 flex items-center justify-center bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.06),rgba(255,255,255,0.01))] text-center text-white/58 transition-opacity duration-500" data-fmap-loading>
                        <div>
                          <div class="mx-auto h-10 w-10 animate-spin rounded-full border-2 border-white/14 border-t-[#8fb84f]"></div>
                          <p class="mt-4 text-sm uppercase tracking-[0.22em]">Loading FMAP</p>
                        </div>
                      </div>
                      <iframe
                        src="/fmap/embed.html"
                        title={`${post.title} interactive FMAP preview`}
                        class="relative z-0 h-full w-full border-0 bg-transparent"
                        loading="lazy"
                        onload="const loader=this.parentElement?.querySelector('[data-fmap-loading]'); if(loader){ loader.style.opacity='0'; setTimeout(()=>loader.remove(), 350); }"
                      ></iframe>
                    </div>
                  ) : isVideoPreview ? (
                    <video
                      src={post.previewImage}
                      aria-label={post.previewAlt ?? post.title}
                      class="relative aspect-[1.2/1] w-full object-cover"
                      autoplay
                      muted
                      loop
                      playsinline
                      preload="metadata"
                    ></video>
                  ) : post.previewImage ? (
                    <div class="relative aspect-[1.2/1] w-full p-6 md:p-8">
                      <img
                        src={post.previewImage}
                        alt={post.previewAlt ?? post.title}
                        class="h-full w-full object-contain transition duration-500 ease-out hover:scale-[1.02]"
                      />
                    </div>
                  ) : (
                    <div class="relative flex aspect-[1.2/1] items-end p-8">
                      <div>
                        <p class="text-sm uppercase tracking-[0.22em] text-white/40">Blog preview</p>
                        <p class="mt-4 max-w-sm text-3xl font-semibold leading-tight text-white/92">{post.title}</p>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}
