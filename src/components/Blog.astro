---
import { siteConfig } from "../config";
const hasBlog = siteConfig.blog && siteConfig.blog.length > 0;
const firstPost = hasBlog ? siteConfig.blog[0] : null;
---

{hasBlog && firstPost && (
  <section id="blog" class="section-shell px-8 py-16 sm:px-12 md:px-20 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 max-w-2xl">
        <p class="section-kicker">Writing</p>
        <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl md:text-5xl">Blog</h2>
        <div class="mt-4 h-1.5 w-20 rounded-full" style={`background-color: ${siteConfig.accentColor}`}></div>
        <p class="mt-6 text-lg leading-8 text-white/56">This is where the site should feel alive: the post list drives a sticky visual panel beside it, so scrolling has rhythm instead of just more text.</p>
      </div>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[0.95fr_1.15fr] lg:items-start lg:gap-10">
        <div class="lg:sticky lg:top-28">
          <div id="blog-preview" class="glass-card overflow-hidden rounded-[2rem]">
            <div class="relative aspect-[4/3] overflow-hidden border-b border-white/8 bg-[#0b1223]">
              <img
                id="blog-preview-image"
                src={firstPost.previewImage ?? "/profile.png"}
                alt={firstPost.previewAlt ?? firstPost.title}
                class="h-full w-full object-cover transition duration-500 ease-out"
              />
              <div class="absolute inset-0 bg-[linear-gradient(180deg,transparent,rgba(5,8,22,0.18)_45%,rgba(5,8,22,0.84))]"></div>
              <div class="absolute inset-x-0 bottom-0 p-6">
                <p id="blog-preview-eyebrow" class="section-kicker text-white/58">{firstPost.previewEyebrow ?? "Featured preview"}</p>
                <h3 id="blog-preview-title" class="mt-3 text-2xl font-semibold text-white">{firstPost.title}</h3>
              </div>
            </div>
            <div class="p-6 md:p-7">
              <p id="blog-preview-description" class="leading-7 text-white/66">{firstPost.description}</p>
              <div class="mt-6 flex items-center gap-3 text-sm text-white/42">
                <span class="inline-block h-2 w-2 rounded-full" style={`background-color: ${siteConfig.accentColor}`}></span>
                <span>Preview updates as you move through the posts</span>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-5">
          {siteConfig.blog.map((post, index) => {
            const modalId = `blog-modal-${index}`;
            return (
              <>
                <article
                  class="blog-preview-trigger glass-card hover-lift rounded-[2rem] p-6 md:p-8"
                  data-preview-image={post.previewImage ?? "/profile.png"}
                  data-preview-alt={post.previewAlt ?? post.title}
                  data-preview-title={post.title}
                  data-preview-description={post.description}
                  data-preview-eyebrow={post.previewEyebrow ?? "Featured preview"}
                  tabindex="0"
                >
                  <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                    <h3 class="text-2xl font-semibold text-white">{post.title}</h3>
                    <span class="inline-flex w-fit rounded-full border px-3 py-1 text-sm font-medium" style={`border-color: ${siteConfig.accentColor}88; color: ${siteConfig.accentColor}; background: rgba(255,255,255,0.03);`}>
                      {post.status}
                    </span>
                  </div>
                  <p class="mt-4 leading-7 text-white/68">{post.description}</p>
                  <div class="mt-5 flex flex-wrap gap-3">
                    <button
                      type="button"
                      class="inline-flex cursor-pointer items-center rounded-full border border-white/14 bg-white/4 px-4 py-2 text-sm font-medium text-white/88 transition-all hover:-translate-y-0.5 hover:border-white/28 hover:bg-white/10"
                      data-modal-open={modalId}
                    >
                      Quick view
                    </button>
                    {post.url && (
                      <a
                        href={post.url}
                        class="inline-flex items-center rounded-full border px-4 py-2 text-sm font-medium transition-all hover:-translate-y-0.5 hover:text-white"
                        style={`border-color: ${siteConfig.accentColor}88; color: ${siteConfig.accentColor}; background: rgba(255,255,255,0.02);`}
                        onMouseOver={`this.style.backgroundColor='${siteConfig.accentColor}'; this.style.color='white';`}
                        onMouseOut={`this.style.backgroundColor='rgba(255,255,255,0.02)'; this.style.color='${siteConfig.accentColor}';`}
                      >
                        Read post
                      </a>
                    )}
                  </div>
                </article>

                <dialog id={modalId} class="modal-backdrop w-[min(42rem,calc(100vw-2rem))] rounded-[1.75rem] border border-white/10 bg-[#08101d] p-0 text-white shadow-2xl backdrop:bg-black/70">
                  <div class="glass-card rounded-[1.75rem] p-6 md:p-8">
                    <div class="flex items-start justify-between gap-6">
                      <div>
                        <p class="section-kicker">Blog post</p>
                        <h3 class="mt-3 text-2xl font-semibold text-white md:text-3xl">{post.title}</h3>
                      </div>
                      <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white/72 transition hover:bg-white/10" data-modal-close={modalId}>✕</button>
                    </div>
                    <p class="mt-6 text-base leading-8 text-white/72">{post.description}</p>
                    {post.url && (
                      <div class="mt-8">
                        <a
                          href={post.url}
                          class="inline-flex items-center rounded-full border px-4 py-2 text-sm font-medium transition-all hover:-translate-y-0.5 hover:text-white"
                          style={`border-color: ${siteConfig.accentColor}88; color: ${siteConfig.accentColor}; background: rgba(255,255,255,0.02);`}
                          onMouseOver={`this.style.backgroundColor='${siteConfig.accentColor}'; this.style.color='white';`}
                          onMouseOut={`this.style.backgroundColor='rgba(255,255,255,0.02)'; this.style.color='${siteConfig.accentColor}';`}
                        >
                          Open post
                        </a>
                      </div>
                    )}
                  </div>
                </dialog>
              </>
            );
          })}
        </div>
      </div>
    </div>
  </section>
)}
