---
import { siteConfig } from "../config";
const hasBlog = siteConfig.blog && siteConfig.blog.length > 0;
---

{hasBlog && (
  <section id="blog" class="bg-gray-50 px-8 py-16 sm:px-12 md:px-20 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="text-3xl font-bold text-gray-900 sm:text-4xl md:text-5xl">Blog</h2>
          <div class="mt-3 h-1.5 w-20 rounded-full" style={`background-color: ${siteConfig.accentColor}`}></div>
          <p class="mt-6 max-w-sm text-lg leading-8 text-gray-600">A starter writing section with a few seeded topics so it doesn't feel empty on day one.</p>
        </div>
        <div class="space-y-6 lg:col-span-8">
          {siteConfig.blog.map((post) => (
            <article class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm md:p-8">
              <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                <h3 class="text-2xl font-semibold text-gray-900">{post.title}</h3>
                <span class="inline-flex w-fit rounded-full border px-3 py-1 text-sm font-medium" style={`border-color: ${siteConfig.accentColor}; color: ${siteConfig.accentColor}`}>
                  {post.status}
                </span>
              </div>
              <p class="mt-4 leading-7 text-gray-700">{post.description}</p>
              {post.url && (
                <div class="mt-5">
                  <a
                    href={post.url}
                    class="inline-flex items-center rounded-full border px-4 py-2 text-sm font-medium transition-colors hover:text-white"
                    style={`border-color: ${siteConfig.accentColor}; color: ${siteConfig.accentColor};`}
                    onMouseOver={`this.style.backgroundColor='${siteConfig.accentColor}'; this.style.color='white';`}
                    onMouseOut={`this.style.backgroundColor='transparent'; this.style.color='${siteConfig.accentColor}';`}
                  >
                    Read post
                  </a>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
