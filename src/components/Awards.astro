---
import { siteConfig } from "../config";
const hasAwards = siteConfig.awards && siteConfig.awards.length > 0;
---

{hasAwards && (
  <section id="awards" class="px-8 py-16 sm:px-12 md:px-20 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="text-3xl font-bold text-gray-900 sm:text-4xl md:text-5xl">Awards</h2>
          <div class="mt-3 h-1.5 w-20 rounded-full" style={`background-color: ${siteConfig.accentColor}`}></div>
        </div>
        <div class="grid gap-6 lg:col-span-8 md:grid-cols-2">
          {siteConfig.awards.map((award) => (
            <article class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm md:p-8">
              <p class="text-sm uppercase tracking-[0.18em] text-gray-500">{award.dateRange}</p>
              <h3 class="mt-3 text-xl font-semibold text-gray-900">{award.title}</h3>
              <p class="mt-4 leading-7 text-gray-700">{award.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
