---
import { siteConfig } from "../config";
const hasAwards = siteConfig.awards && siteConfig.awards.length > 0;
---

{hasAwards && (
  <section id="awards" class="section-shell px-8 py-16 sm:px-12 md:px-20 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="section-kicker">Recognition</p>
          <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl md:text-5xl">Awards</h2>
          <div class="mt-4 h-1.5 w-20 rounded-full" style={`background-color: ${siteConfig.accentColor}`}></div>
        </div>
        <div class="grid gap-6 lg:col-span-8 md:grid-cols-2">
          {siteConfig.awards.map((award) => (
            <article class="glass-card hover-lift p-6 md:p-8">
              <p class="text-sm uppercase tracking-[0.18em] text-white/42">{award.dateRange}</p>
              <h3 class="mt-3 text-xl font-medium text-white">{award.title}</h3>
              <p class="mt-4 leading-7 text-white/68">{award.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
