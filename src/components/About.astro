---
import { siteConfig } from "../config";
---

<section id="about" class="px-8 py-16 sm:px-12 md:px-20 md:py-24">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <h2 class="text-3xl font-bold text-gray-900 sm:text-4xl md:text-5xl">About</h2>
        <div class="mt-3 h-1.5 w-20 rounded-full" style={`background-color: ${siteConfig.accentColor}`}></div>
      </div>
      <div class="space-y-6 lg:col-span-8">
        {siteConfig.aboutMe.map((paragraph) => (
          <p class="text-lg leading-8 text-gray-700">{paragraph}</p>
        ))}
        <div class="pt-4">
          <div class="flex flex-wrap gap-3">
            {siteConfig.skills.map((skill) => (
              <span class="rounded-full border border-gray-200 bg-gray-50 px-4 py-2 text-sm font-medium text-gray-800">
                {skill}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
