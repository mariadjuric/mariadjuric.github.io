---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{hasEducation && (
  <section id="education" class="bg-gray-50 px-8 py-16 sm:px-12 md:px-20 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="text-3xl font-bold text-gray-900 sm:text-4xl md:text-5xl">Education</h2>
          <div class="mt-3 h-1.5 w-20 rounded-full" style={`background-color: ${siteConfig.accentColor}`}></div>
        </div>
        <div class="space-y-6 lg:col-span-8">
          {siteConfig.education.map((edu) => (
            <article class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm md:p-8">
              <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                <div>
                  <h3 class="text-2xl font-semibold text-gray-900">{edu.school}</h3>
                  <p class="mt-1 text-base font-medium" style={`color: ${siteConfig.accentColor}`}>{edu.degree}</p>
                </div>
                <p class="text-sm uppercase tracking-[0.18em] text-gray-500">{edu.dateRange}</p>
              </div>
              <ul class="mt-5 space-y-3">
                {edu.achievements.map((achievement) => (
                  <li class="flex gap-3 text-gray-700">
                    <span class="mt-2 inline-block h-2 w-2 flex-shrink-0 rounded-full" style={`background-color: ${siteConfig.accentColor}`}></span>
                    <span class="leading-7">{achievement}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
