---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{hasExperience && (
  <section id="experience" class="section-shell px-8 py-16 sm:px-12 md:px-20 md:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="section-kicker">Timeline</p>
          <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl md:text-5xl">Research & experience</h2>
          <div class="mt-4 h-1.5 w-20 rounded-full" style={`background-color: ${siteConfig.accentColor}`}></div>
        </div>
        <div class="space-y-6 lg:col-span-8">
          {siteConfig.experience.map((exp) => (
            <article class="glass-card hover-lift rounded-[2rem] p-6 md:p-8">
              <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                <div>
                  <h3 class="text-2xl font-semibold text-white">{exp.title}</h3>
                  <p class="mt-1 text-base font-medium" style={`color: ${siteConfig.accentColor}`}>{exp.company}</p>
                </div>
                <p class="text-sm uppercase tracking-[0.18em] text-white/42">{exp.dateRange}</p>
              </div>
              <ul class="mt-5 space-y-3">
                {exp.bullets.map((bullet) => (
                  <li class="flex gap-3 text-white/68">
                    <span class="mt-2 inline-block h-2 w-2 flex-shrink-0 rounded-full" style={`background-color: ${siteConfig.accentColor}`}></span>
                    <span class="leading-7">{bullet}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
