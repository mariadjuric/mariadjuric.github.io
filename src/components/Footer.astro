---
import { siteConfig } from "../config";
---

<footer class="px-8 py-12 sm:px-12 md:px-20">
  <div class="mx-auto max-w-7xl">
    <div class="glass-card rounded-[2rem] px-6 py-8 md:px-8">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <h3 class="text-2xl font-bold text-white">{siteConfig.name}</h3>
          <p class="mt-2 text-white/66">{siteConfig.title}</p>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-white/46">{siteConfig.footerNote}</p>
        </div>
        <div class="text-sm text-white/48 md:text-right">
          <p>{siteConfig.location}</p>
          <p class="mt-1"><a href={`mailto:${siteConfig.social.email}`} class="transition-colors hover:text-white">{siteConfig.social.email}</a></p>
          <p class="mt-4">© {new Date().getFullYear()} {siteConfig.name}</p>
        </div>
      </div>
    </div>
  </div>
</footer>
