---
import { siteConfig } from "../config";
---

<footer class="border-t border-gray-200 bg-white px-8 py-12 sm:px-12 md:px-20">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div>
      <h3 class="text-2xl font-bold text-gray-900">{siteConfig.name}</h3>
      <p class="mt-2 text-gray-600">{siteConfig.title}</p>
      <p class="mt-4 max-w-2xl text-sm leading-7 text-gray-500">{siteConfig.footerNote}</p>
    </div>
    <div class="text-sm text-gray-500 md:text-right">
      <p>{siteConfig.location}</p>
      <p class="mt-1"><a href={`mailto:${siteConfig.social.email}`} class="hover:text-gray-900">{siteConfig.social.email}</a></p>
      <p class="mt-4">© {new Date().getFullYear()} {siteConfig.name}</p>
    </div>
  </div>
</footer>
