---
import { siteConfig } from "../config";
---

<div
  id="hero"
  class="relative isolate overflow-hidden pt-28 pb-20 md:pt-36 md:pb-28"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,_rgba(98,127,47,0.24),_transparent_35%),radial-gradient(circle_at_bottom_right,_rgba(98,127,47,0.10),_transparent_30%)]"></div>
  <div class="mx-auto max-w-7xl px-8 sm:px-12 md:px-20">
    <div class="glass-card relative overflow-hidden rounded-[2rem] px-8 py-10 sm:px-10 md:px-14 md:py-14">
      <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(255,255,255,0.05),transparent_45%,rgba(98,127,47,0.10))]"></div>
      <div class="relative grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.35fr_0.8fr]">
        <div>
          <p class="section-kicker">{siteConfig.heroGreeting}</p>
          <h1 class="mt-4 text-5xl font-bold tracking-tight text-white sm:text-6xl md:text-7xl">
            <span style={{ color: siteConfig.accentColor }}>{siteConfig.name}</span>
          </h1>
          <p class="mt-6 max-w-3xl text-xl leading-8 text-white/88 md:text-2xl">
            {siteConfig.title}
          </p>
          <p class="mt-6 max-w-3xl text-base leading-8 text-white/68 md:text-lg">
            {siteConfig.heroSubtitle}
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4 text-white/72">
            <a
              href={`mailto:${siteConfig.social.email}`}
              aria-label="Email"
              class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/12 bg-white/4 transition-all hover:-translate-y-0.5 hover:border-white/28 hover:bg-white/10 hover:text-white"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                <path d="M3 7l9 6l9 -6" />
              </svg>
            </a>
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/12 bg-white/4 transition-all hover:-translate-y-0.5 hover:border-white/28 hover:bg-white/10 hover:text-white"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M8 11v5" />
                <path d="M8 8v.01" />
                <path d="M12 16v-5" />
                <path d="M16 16v-3a2 2 0 1 0 -4 0" />
                <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" />
              </svg>
            </a>
            <a
              href={siteConfig.social.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/12 bg-white/4 transition-all hover:-translate-y-0.5 hover:border-white/28 hover:bg-white/10 hover:text-white"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
              </svg>
            </a>
          </div>

          <div class="mt-8 flex flex-wrap gap-4">
            <a href="#projects" class="inline-flex items-center rounded-full px-6 py-3 text-white transition-all hover:-translate-y-0.5 hover:opacity-95" style={`background: linear-gradient(135deg, ${siteConfig.accentColor}, #89a950); box-shadow: 0 18px 38px ${siteConfig.accentColor}44;`}>
              View projects
            </a>
            <a href="#about" class="inline-flex items-center rounded-full border border-white/14 bg-white/4 px-6 py-3 text-white/90 transition-all hover:-translate-y-0.5 hover:border-white/28 hover:bg-white/8">
              About me
            </a>
          </div>

          <a href="#about" class="mt-12 inline-flex items-center gap-3 text-sm uppercase tracking-[0.28em] text-white/48 transition-colors hover:text-white/80">
            <span>Scroll to explore</span>
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/10 bg-white/4">
              ↓
            </span>
          </a>
        </div>

        <div class="flex justify-center lg:justify-end">
          <div class="relative w-full max-w-[17rem] sm:max-w-[18.5rem] md:max-w-[21rem]">
            <div class="absolute -inset-5 rounded-[2rem] opacity-80 blur-3xl" style={`background: linear-gradient(135deg, ${siteConfig.accentColor}55, rgba(255,255,255,0.05) 75%)`}></div>
            <div class="glass-card relative overflow-hidden rounded-[2rem] p-2">
              <img
                src={siteConfig.profileImage}
                alt={siteConfig.profileImageAlt}
                class="aspect-[4/5] w-full rounded-[1.6rem] object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
