---
import { siteConfig } from "../config";
---

<div
  id="hero"
  class="relative isolate overflow-hidden bg-white pt-28 pb-16 md:pt-36 md:pb-24"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,_rgba(85,107,47,0.16),_transparent_40%),radial-gradient(circle_at_bottom_right,_rgba(85,107,47,0.10),_transparent_35%)]"></div>
  <div class="mx-auto max-w-7xl px-8 sm:px-12 md:px-20">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.4fr_0.8fr]">
      <div>
        <p class="text-sm uppercase tracking-[0.3em] text-gray-500">{siteConfig.heroGreeting}</p>
        <h1 class="mt-4 text-5xl font-bold tracking-tight text-gray-900 sm:text-6xl md:text-7xl">
          <span style={{ color: siteConfig.accentColor }}>{siteConfig.name}</span>
        </h1>
        <p class="mt-6 max-w-3xl text-xl leading-8 text-gray-700 md:text-2xl">
          {siteConfig.title}
        </p>
        <p class="mt-6 max-w-3xl text-base leading-8 text-gray-600 md:text-lg">
          {siteConfig.heroSubtitle}
        </p>

        <div class="mt-8 flex flex-wrap gap-3 text-sm text-gray-700">
          <span class="rounded-full border border-gray-300 px-4 py-2 bg-white">{siteConfig.location}</span>
          <a class="rounded-full border border-gray-300 px-4 py-2 bg-white hover:border-gray-500 transition-colors" href={`mailto:${siteConfig.social.email}`}>{siteConfig.social.email}</a>
          <a class="rounded-full border border-gray-300 px-4 py-2 bg-white hover:border-gray-500 transition-colors" href={`tel:${siteConfig.phone.replace(/\s+/g, "")}`}>{siteConfig.phone}</a>
        </div>

        <div class="mt-8 flex flex-wrap gap-4">
          <a href="#projects" class="inline-flex items-center rounded-full px-6 py-3 text-white transition-opacity hover:opacity-90" style={`background-color: ${siteConfig.accentColor}`}>
            View projects
          </a>
          <a href="#about" class="inline-flex items-center rounded-full border border-gray-300 px-6 py-3 text-gray-900 hover:border-gray-500 transition-colors">
            About me
          </a>
        </div>
      </div>

      <div class="flex justify-center lg:justify-end">
        <div class="relative w-full max-w-sm">
          <div class="absolute -inset-4 rounded-[2rem] opacity-60 blur-2xl" style={`background: linear-gradient(135deg, ${siteConfig.accentColor}33, transparent 65%)`}></div>
          <div class="relative overflow-hidden rounded-[2rem] border border-gray-200 bg-white p-3 shadow-xl">
            <img
              src={siteConfig.profileImage}
              alt={siteConfig.profileImageAlt}
              class="aspect-[4/5] w-full rounded-[1.5rem] object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
